<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Target everything from .NET Framework 4.7.2 to .NET 10.0 -->
        <TargetFrameworks>net472;netcoreapp2.2;netcoreapp3.1;net5.0;net6.0;net8.0;net10.0</TargetFrameworks>
        
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>DeepEquals.Fixtures</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        
        <!-- The language-version matrix from the design: the emitted code must be C# 7.3-clean on the lowest tier. -->
        <LangVersion Condition="'$(TargetFramework)' == 'net472'">7.3</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'netcoreapp2.2'">7.3</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'netcoreapp3.1'">8</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'net5.0'">9</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'net6.0'">10</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'net8.0'">12</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'net10.0'">14</LangVersion>
        
        <!-- Models are written once in C# 7.3 style; the generated files carry their own nullable directive. -->
        <Nullable>disable</Nullable>
        <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        
        <!-- DEQ004 is deliberate: Holder.Words is an IEnumerable member to exercise the ordered interface path. -->
        <NoWarn>$(NoWarn);NU1701;CS8632;DEQ004</NoWarn>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!-- The netcoreapp2.2 leg's platform package, out of support since 2019; these advisories will never be fixed in it. -->
    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-x5qj-9vmx-7g6g" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2xjx-v99w-gqf3" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-6px8-22w5-w334" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="FluentAssertions" Version="7.2.0" />
    </ItemGroup>

    <!--
      Each leg takes the newest test host and xunit adapter that still run on it. 17.14 ships no test host below net8.0,
      so the netcoreapp3.1, net5.0 and net6.0 legs take 17.11; 17.3 is the last with a netcoreapp2.x host.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp2.2'">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.3" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp3.1' or '$(TargetFramework)' == 'net5.0' or '$(TargetFramework)' == 'net6.0'">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'netcoreapp2.2' and '$(TargetFramework)' != 'netcoreapp3.1' and '$(TargetFramework)' != 'net5.0' and '$(TargetFramework)' != 'net6.0'">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    </ItemGroup>

    <!-- 2.4.3 is the last adapter for netcoreapp2.x and 2.4.5 the last for netcoreapp3.1 and net5.0; every other leg takes the current one. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp2.2'">
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp3.1' or '$(TargetFramework)' == 'net5.0'">
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'netcoreapp2.2' and '$(TargetFramework)' != 'netcoreapp3.1' and '$(TargetFramework)' != 'net5.0'">
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DeepEquals.SourceGeneration.Framework\DeepEquals.SourceGeneration.Framework.csproj" />
        <ProjectReference Include="..\..\src\DeepEquals.SourceGenerator\DeepEquals.SourceGenerator.csproj" 
                          OutputItemType="Analyzer" 
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
