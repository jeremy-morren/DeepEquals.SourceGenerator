<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Target everything from .NET Framework 4.7.2 to .NET 10.0 -->
        <TargetFrameworks>net472;netcoreapp3.1;net6.0;net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>DeepEquals.SourceGeneration.Framework.Tests</RootNamespace>
        
        <!-- 
          netcoreapp3.1 and net472 are deliberate out-of-support fixture runtimes
          to test the netstandard2.0 and netstandard2.1 assets on real runtimes.
         -->
        <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        
        <NoWarn>$(NoWarn);NU1701</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="FluentAssertions" Version="7.2.0" />
    </ItemGroup>

    <!-- 17.14 ships no test host below net8.0, so the netcoreapp3.1 and net6.0 legs take the last one that does. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp3.1' or '$(TargetFramework)' == 'net6.0'">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'netcoreapp3.1' and '$(TargetFramework)' != 'net6.0'">
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    </ItemGroup>

    <!-- The last runner with a netcoreapp3.1 adapter; every other leg takes the current one. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp3.1'">
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'netcoreapp3.1'">
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DeepEquals.SourceGeneration.Framework\DeepEquals.SourceGeneration.Framework.csproj" />
    </ItemGroup>

</Project>
