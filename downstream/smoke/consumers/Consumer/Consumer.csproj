<!--
    One clean consumer across every target the package claims. The netstandard legs are libraries,
    because a netstandard assembly cannot run; building them proves the generated code compiles
    against that reference surface. The rest are executables the smoke tests run.
-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;netstandard2.1;net472;net6.0;net7.0;net8.0;net10.0</TargetFrameworks>
        <OutputType Condition="!$(TargetFramework.StartsWith('netstandard'))">Exe</OutputType>
        <RootNamespace>DeepEquals.Smoke</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!--
            The emitted code must be clean at the oldest language version a tier can be compiled with: netstandard2.0
            stays at C# 7.3 and netstandard2.1 at C# 8. The runnable tiers, .NET Framework included, take the latest
            language, so the record models are exercised on every runtime.
        -->
        <LangVersion>latest</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.0'">7.3</LangVersion>
        <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">8</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>

    <!-- The design's "spans without framework helpers" variant: netstandard2.0 with System.Memory. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Memory" Version="4.6.3" />
    </ItemGroup>

    <Import Project="../../../models/Models.props" />

</Project>
