<!--
    A Blazor WebAssembly application that renders the shared assertions. Published output is trimmed,
    which is where a generated context would be reported as trim-unsafe for a real Blazor consumer, and
    the smoke tests then load the published app in a headless browser and read the result off the page.
    Blazor's own scaffolding warns about its router, so warnings are not errors here; the tests assert
    that none of them name this package.
-->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>DeepEquals.Smoke.BlazorWasm</RootNamespace>
        <PublishTrimmed>true</PublishTrimmed>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    </ItemGroup>

    <Import Project="../../../models/Models.props" />

</Project>
