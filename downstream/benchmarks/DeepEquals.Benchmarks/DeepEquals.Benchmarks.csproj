<!--
    Times the generated comparers against built-in equality over the shared scenarios, on every runnable platform the
    package claims. Restores the packages from the local feed like a smoke consumer, so it runs after `dotnet pack`:

        dotnet run -c Release -f net10.0
        dotnet run -c Release -f net472

    The switcher then asks which benchmarks to run; a filter argument after the double dash answers it up front.
    Benchmarks run in process, so one build per target framework is all the toolchain needs, on .NET Framework too.
    The browser is covered by the Blazor smoke consumer, which runs the same scenarios through the stopwatch harness.
-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net472;net6.0;net7.0;net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>DeepEquals.Benchmarks</RootNamespace>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <NoWarn>$(NoWarn);CS8632</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <Import Project="../../models/Models.props" />

</Project>
