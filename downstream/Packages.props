<!--
    The documented setup, for every project here that consumes the packed packages: the analyzer private to the
    project, the runtime library flowing normally. Imported by the smoke consumers and by the benchmarks; the smoke
    test driver itself does not consume the packages and does not import this.
-->
<Project>

    <PropertyGroup>
        <!--
            Floating, so nothing has to thread the version through from version.props.
            Source mapping in NuGet.config keeps this resolving against the local feed,
            so it always means "whatever was just packed" rather than "the newest release".
        -->
        <DeepEqualsVersion Condition="'$(DeepEqualsVersion)' == ''">*-*</DeepEqualsVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DeepEquals.SourceGenerator" Version="$(DeepEqualsVersion)" PrivateAssets="all" />
        <PackageReference Include="DeepEquals.SourceGeneration.Framework" Version="$(DeepEqualsVersion)" />
    </ItemGroup>

    <!-- Building net472 away from Windows needs the reference assemblies from NuGet. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

</Project>
