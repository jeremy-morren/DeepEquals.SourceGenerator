<Project>

    <Import Project="version.props" />

    <PropertyGroup>
        <Authors>Jeremy Morren</Authors>
        <Copyright>Copyright © Jeremy Morren</Copyright>
        <NeutralLanguage>en-GB</NeutralLanguage>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        
        <!-- Eol target frameworks are used to test the source generator on the lowest supported framework, but they are not shipped. -->
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
        
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <Description>
            A Roslyn source generator that emits deep, by-value IEqualityComparer&lt;T&gt; implementations for a closed set of types: 
            cycle-safe, allocation-conscious, exact-representation leaves, and unordered set/dictionary semantics.
        </Description>
        <PackageTags>equality;comparer;source-generator;roslyn;deep-equals</PackageTags>
    </PropertyGroup>

    <PropertyGroup>
        <DebugType>embedded</DebugType>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- Deterministic builds for everyone -->
    <PropertyGroup>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- Strong-name every assembly -->
    <PropertyGroup>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)eng/DeepEquals.snk</AssemblyOriginatorKeyFile>
        <DeepEqualsPublicKey></DeepEqualsPublicKey>
    </PropertyGroup>

</Project>
