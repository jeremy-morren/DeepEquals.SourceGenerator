<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net8.0;net10.0</TargetFrameworks>
    <!-- Pinned so an SDK upgrade cannot change how the shipped assets compile without a deliberate edit. -->
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DeepEquals.SourceGeneration.Framework</RootNamespace>
    <AssemblyName>DeepEquals.SourceGeneration.Framework</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      The runtime half, shipped on its own so it can flow to everything downstream while the analyzer
      stays private to the project that declares a context. Generated code compiles against this.
    -->
    <IsPackable>true</IsPackable>
    <PackageId>DeepEquals.SourceGeneration.Framework</PackageId>
    <Description>The runtime library the code generated by DeepEquals.SourceGenerator compiles against: comparison state, hashing, collection helpers and the context base type. Reference this alongside the generator; a project that only consumes generated comparers needs this package alone.</Description>
    <PackageTags>equality;comparer;source-generator;roslyn;deep-equals</PackageTags>
    <DevelopmentDependency>false</DevelopmentDependency>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeepEquals.SourceGeneration.Framework.Tests" 
                        Key="$(DeepEqualsPublicKey)" />
  </ItemGroup>

</Project>
