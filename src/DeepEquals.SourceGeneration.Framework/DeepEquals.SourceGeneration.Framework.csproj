<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <!-- 
          The framework package is provided for every target framework separately.
          The analyzer is provided as a separate package (targeting netstandard2.0) and is not included in build output.
          Generated code compiles against this package.
        -->
        <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net8.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        
        <LangVersion>13</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
        <!-- Supress CS1591: missing XML comment warning-->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <DevelopmentDependency>false</DevelopmentDependency>
    </PropertyGroup>

    <!-- Enable features on frameworks where they are available -->
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>
    
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!--
      XxHash3 for sequences of bit-block elements: on each asset, the newest release that builds without a warning on
      every runtime that asset serves. 9.x and 10.x warn below net8.0, so the net6.0 asset, which also serves net7.0,
      takes 8.0.0. netstandard2.0 serves .NET Framework, which 10.x supports from 4.6.2. The netstandard2.1 asset serves
      netcoreapp3.1 to net5.0, where every release warns, so it does without, and the generator keeps the per-element
      path there. On netstandard2.0 the package also brings System.Memory, referenced directly because the block helpers
      use MemoryMarshal, so a .NET Framework consumer gains ReadOnlySpan<T> and the generated span paths with it.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Memory" Version="4.6.3" />
    </ItemGroup>

    <!-- Include required packages on frameworks -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Buffers" Version="4.6.1" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DeepEquals.SourceGeneration.Framework.Tests" 
                            Key="$(DeepEqualsPublicKey)" />
    </ItemGroup>

</Project>
