<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <!-- 
          The framework package is provided for every target framework separately.
          The analyzer is provided as a separate package (targeting netstandard2.0) and is not included in build output.
          Generated code compiles against this package.
        -->
        <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net8.0;net10.0</TargetFrameworks>
        <IsPackable>true</IsPackable>
        
        <LangVersion>13</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
        <!-- Supress CS1591: missing XML comment warning-->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <DevelopmentDependency>false</DevelopmentDependency>
    </PropertyGroup>

    <!-- Enable features on frameworks where they are available -->
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>
    
    <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <!--
      XxHash3 for sequences of bit-block elements. 8.0.0 is the version that supports every runtime the net6.0 and later
      assets serve and .NET Framework through netstandard2.0; later versions warn on net6.0 and net7.0 consumers. The
      netstandard2.1 asset serves netcoreapp3.1 to net5.0, where 8.0.0 warns too, so that asset does without it and the
      generator keeps the per-element path there. On netstandard2.0 the package brings System.Memory, pinned below to the
      release built against the Unsafe version this asset already uses, so a .NET Framework consumer gains
      ReadOnlySpan<T> and the generated span paths with it.
    -->
    <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
        <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Memory" Version="4.6.3" />
    </ItemGroup>

    <!-- Include required packages on frameworks -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Buffers" Version="4.6.1" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DeepEquals.SourceGeneration.Framework.Tests" 
                            Key="$(DeepEqualsPublicKey)" />
    </ItemGroup>

</Project>
